load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//kicad/private:extensions.bzl", "DEFAULT_KICAD_VERSION")
load("//kicad/private:kicad_toolchain.bzl", "kicad_stub_toolchain")
load("//kicad/private:normalize.bzl", "normalize_toolchain")
load("//kicad/private:toolchains.bzl", "helpers_toolchain", "unsupported_platform_toolchain")

# --@rules_kicad//kicad/toolchains:use_stub swaps every tool for the stub.
# swap_test sets it with a transition. A tool toolchain honors it by
# carrying target_settings = [":stub_off"], and its stub twin
# target_settings = [":stub_on"].
bool_flag(
    name = "use_stub",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "stub_on",
    flag_values = {":use_stub": "true"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "stub_off",
    flag_values = {":use_stub": "false"},
    visibility = ["//visibility:public"],
)

helpers_toolchain(
    name = "helpers_impl",
    canary_board = "//kicad/private/drucanary:canary.kicad_pcb",
    compare = "//kicad/private/detcompare",
    drucanary = "//kicad/private/drucanary",
    launcher = "//kicad/private/launcher",
    reportcheck = "//kicad/private/reportcheck",
    sheetcheck = "//kicad/private/sheetcheck",
    sheetcheck_test = "//kicad/private/sheetcheck",
    swapcheck = "//kicad/private/swapcheck",
    tablecheck = "//kicad/private/tablecheck",
)

# The helpers run on Linux x86_64 only in v1 (spec P1). The outputs of the
# rules are files for any platform, so the target platform is not
# constrained here; issue #6 adds the analysis-time check for other hosts.
toolchain(
    name = "helpers",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":helpers_impl",
    toolchain_type = "//kicad:helpers_toolchain_type",
)

# Any other execution platform: Bazel tries toolchains in the order they
# are registered, and MODULE.bazel registers this one last, so it is
# picked only where the one above does not match. Its analysis fails with
# a message that says which platform is supported (spec P1).
unsupported_platform_toolchain(
    name = "unsupported_impl",
    tags = ["manual"],
    visibility = ["//tests:__subpackages__"],
)

toolchain(
    name = "unsupported",
    toolchain = ":unsupported_impl",
    toolchain_type = "//kicad:helpers_toolchain_type",
)

# swap_test's KiCad: the stub stands in for kicad-cli. The real toolchain
# is in @kicad_toolchains (kicad/private/extensions.bzl).
kicad_stub_toolchain(
    name = "kicad_stub_impl",
    stub = "//kicad/private/stub",
    version = DEFAULT_KICAD_VERSION,
)

toolchain(
    name = "kicad_stub",
    target_settings = [":stub_on"],
    toolchain = ":kicad_stub_impl",
    toolchain_type = "//kicad:toolchain_type",
)

# The normalizer, built from source (kicad/private/normalize), and its
# stand-in for swap_test.
normalize_toolchain(
    name = "normalize_impl",
    normalize = "//kicad/private/normalize",
)

toolchain(
    name = "normalize",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = [":stub_off"],
    toolchain = ":normalize_impl",
    toolchain_type = "//kicad:normalize_toolchain_type",
)

normalize_toolchain(
    name = "normalize_stub_impl",
    normalize = "//kicad/private/stub",
)

toolchain(
    name = "normalize_stub",
    target_settings = [":stub_on"],
    toolchain = ":normalize_stub_impl",
    toolchain_type = "//kicad:normalize_toolchain_type",
)
