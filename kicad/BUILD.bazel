load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "int_flag")

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//kicad/private"],
)

# The toolchain type of this module's own Go helpers: the launcher that
# every action runs through, and the stub and checker of swap_test.
toolchain_type(
    name = "helpers_toolchain_type",
    visibility = ["//visibility:public"],
)

# The toolchain type of the normalizer, which removes KiCad's time stamps.
toolchain_type(
    name = "normalize_toolchain_type",
    visibility = ["//visibility:public"],
)

# The time every time stamp in an output becomes, in seconds since 1970
# UTC (spec D2): --@rules_kicad//kicad:source_date_epoch=1700000000.
int_flag(
    name = "source_date_epoch",
    build_setting_default = 0,
    visibility = ["//visibility:public"],
)

# The toolchain type of KiCad: kicad-cli and its data (KicadToolchainInfo).
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//kicad/private"],
)

exports_files(
    [
        "defs.bzl",
        "extensions.bzl",
    ],
    visibility = ["//docs:__pkg__"],
)
