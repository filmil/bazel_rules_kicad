load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "tablecheck_lib",
    srcs = ["main.go"],
    importpath = "github.com/filmil/bazel_rules_kicad/kicad/private/tablecheck",
    visibility = ["//visibility:private"],
)

# Pure Go, so a user of the module needs no C++ toolchain to build it.
go_binary(
    name = "tablecheck",
    embed = [":tablecheck_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "tablecheck_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":tablecheck_lib"],
    pure = "on",
)
