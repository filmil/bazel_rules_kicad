load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# Fails kicad_render when a part's 3D model is not in its models. It reads
# the board, as kicad-cli's render log says nothing of a missing model;
# see main.go.

go_library(
    name = "modelcheck_lib",
    srcs = ["main.go"],
    importpath = "github.com/filmil/bazel_rules_kicad/kicad/private/modelcheck",
    visibility = ["//visibility:private"],
    deps = ["//kicad/private/sexpr"],
)

# Pure Go, so a user of the module needs no C++ toolchain to build it.
go_binary(
    name = "modelcheck",
    embed = [":modelcheck_lib"],
    pure = "on",
    visibility = ["//kicad/toolchains:__pkg__"],
)

go_test(
    name = "modelcheck_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":modelcheck_lib"],
    pure = "on",
)
