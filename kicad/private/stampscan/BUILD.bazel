load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "stampscan_lib",
    srcs = ["main.go"],
    importpath = "github.com/filmil/bazel_rules_kicad/kicad/private/stampscan",
    visibility = ["//visibility:private"],
)

# Pure Go, so a user of the module needs no C++ toolchain to build it.
go_binary(
    name = "stampscan",
    embed = [":stampscan_lib"],
    pure = "on",
    # Only the helpers toolchain names it.
    visibility = ["//kicad/toolchains:__pkg__"],
)

go_test(
    name = "stampscan_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":stampscan_lib"],
    pure = "on",
)
