load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "drucanary_lib",
    srcs = ["main.go"],
    importpath = "github.com/filmil/bazel_rules_kicad/kicad/private/drucanary",
    visibility = ["//visibility:private"],
)

# Pure Go, so a user of the module needs no C++ toolchain to build it.
go_binary(
    name = "drucanary",
    embed = [":drucanary_lib"],
    pure = "on",
    visibility = ["//kicad/toolchains:__pkg__"],
)

go_test(
    name = "drucanary_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":drucanary_lib"],
    pure = "on",
)

# The canary board: a 10 mm square and one 0.25 mm track, which the canary
# rule (47.11 mm minimum) flags. Made once with KiCad 9.0.9's own Python.
exports_files(
    ["canary.kicad_pcb"],
    visibility = ["//kicad/toolchains:__pkg__"],
)
