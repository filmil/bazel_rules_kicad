load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load(":library_test.bzl", "relative_path_test", "relative_to_test")

bzl_library(
    name = "private",
    srcs = [
        "bom.bzl",
        "design.bzl",
        "determinism.bzl",
        "drc.bzl",
        "erc.bzl",
        "extensions.bzl",
        "gerbers.bzl",
        "kicad_toolchain.bzl",
        "library.bzl",
        "netlist.bzl",
        "normalize.bzl",
        "render.bzl",
        "report_test.bzl",
        "run_tool.bzl",
        "sch_pdf.bzl",
        "sch_render.bzl",
        "swap_test.bzl",
        "toolchains.bzl",
    ],
    # The kicad_toolchains repository loads kicad_toolchain.bzl.
    visibility = ["//visibility:public"],
    deps = ["@bazel_skylib//rules:common_settings"],
)

# A setting that changes nothing but the configuration. determinism_test
# builds its target once with "a" and once with "b", so every action runs
# twice, with different output paths.
string_flag(
    name = "determinism_salt",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

# The paths that write_lib_tables puts in the tables.
relative_to_test(
    name = "relative_to_test",
    size = "small",
)

# The sheet paths that kicad_schematic stages.
relative_path_test(
    name = "relative_path_test",
    size = "small",
)
