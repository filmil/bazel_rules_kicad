"""The `kicad` module extension: the prebuilt KiCad toolchain (spec H2, H4)."""

# The prebuilt KiCad trees, by the version kicad-cli reports. Each is the
# official lite AppImage of that version (9.0.9.1 is the AppImage's own
# revision 1 of KiCad 9.0.9), unpacked without running it and packed as a
# reproducible tarball by make-kicad-prebuilt.sh. The release notes of each asset name
# the AppImage it came from and its sha256. Only this repository's release
# hosts the tarball, so it has one URL.
_KICAD = {
    "9.0.9": struct(
        urls = ["https://github.com/filmil/bazel_rules_kicad/releases/download/prebuilt-kicad-9.0.9.1/kicad-9.0.9.1-linux-x86_64.tar.xz"],
        sha256 = "7f570bd2161a2dbdd0dca9ef7ba0ab751d422b379c6209385491ecc047f93bff",
        strip_prefix = "kicad-9.0.9.1-linux-x86_64",
        # Links that point outside the tree; a glob would fail on them.
        remove = [
            "shared/lib/python3.11/sitecustomize.py",
            "shared/lib/python3.11/config-3.11-x86_64-linux-gnu/libpython3.11.so",
        ],
    ),
}

DEFAULT_KICAD_VERSION = "9.0.9"

# Freerouting, the autorouter of kicad_autoroute: its jar, which runs on
# rules_java's JDK 25. This repository's release mirrors it; Freerouting's
# own release is second. (The native CLI of the same release crashes when
# it routes, so the jar it is.)
FREEROUTING_VERSION = "2.5.0"

_FREEROUTING = struct(
    urls = [
        "https://github.com/filmil/bazel_rules_kicad/releases/download/mirror-freerouting-2.5.0-jar/freerouting-2.5.0.jar",
        "https://github.com/freerouting/freerouting/releases/download/v2.5.0/freerouting-2.5.0.jar",
    ],
    sha256 = "f6f51bb02245e8e717f9359bd260cc9c5c0b1bc0acc8b7cb2cd5b8ffeb5de3c7",
)

# KiCad's symbol and footprint libraries, by KiCad version. GitLab makes
# these archives on demand, so its bytes may change: this repository's
# release is first, GitLab second. 3D models are not here: they are
# several GB (issue #11 notes), and come in their own repositories.
_LIBS = {
    "9.0.9": {
        "symbols": struct(
            urls = [
                "https://github.com/filmil/bazel_rules_kicad/releases/download/prebuilt-kicad-libs-9.0.9/kicad-symbols-9.0.9.tar.gz",
                "https://gitlab.com/kicad/libraries/kicad-symbols/-/archive/9.0.9/kicad-symbols-9.0.9.tar.gz",
            ],
            sha256 = "06ef18935edb5aab03708006a37753c607ef2dcd735a8abdf36d816523696516",
            strip_prefix = "kicad-symbols-9.0.9",
        ),
        "footprints": struct(
            urls = [
                "https://github.com/filmil/bazel_rules_kicad/releases/download/prebuilt-kicad-libs-9.0.9/kicad-footprints-9.0.9.tar.gz",
                "https://gitlab.com/kicad/libraries/kicad-footprints/-/archive/9.0.9/kicad-footprints-9.0.9.tar.gz",
            ],
            sha256 = "f36f804056ebbe36e7fb53e897d20e905c6b5863f7cff43cceccdf54492f7d9a",
            strip_prefix = "kicad-footprints-9.0.9",
        ),
    },
}

# The AppImage ships no fonts, and its fonts.conf names host directories.
# KiCad's own stroke font is built in; outline (TTF) text needs these.
_FONTS = struct(
    urls = ["https://github.com/dejavu-fonts/dejavu-fonts/releases/download/version_2_37/dejavu-fonts-ttf-2.37.tar.bz2"],
    sha256 = "fa9ca4d13871dd122f61258a80d01751d603b4d3ee14095d65453b4e846e17d7",
    strip_prefix = "dejavu-fonts-ttf-2.37",
)

# fontconfig reads only this: the fonts above, found relative to this file,
# and a cache under XDG_CACHE_HOME, which run_tool points inside the action.
_FONTS_CONF = """<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <dir prefix="relative">fonts/ttf</dir>
  <cachedir prefix="xdg">fontconfig</cachedir>
</fontconfig>
"""

_BUILD = """# Generated by the kicad module extension of hdlf_rules_kicad.
load("@hdlf_rules_kicad//kicad/private:kicad_toolchain.bzl", "kicad_toolchain")

kicad_toolchain(
    name = "kicad_impl",
    data = glob(["kicad/**"], allow_empty = False),
    fonts = glob(["fonts/ttf/*.ttf"]),
    fonts_conf = "fonts.conf",
    kicad_cli = "kicad/bin/kicad-cli",
    kicad_python = "kicad/bin/python3.11",
    version = "{version}",
)

toolchain(
    name = "kicad",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = ["@hdlf_rules_kicad//kicad/toolchains:stub_off"],
    toolchain = ":kicad_impl",
    toolchain_type = "@hdlf_rules_kicad//kicad:toolchain_type",
)
"""

def _kicad_toolchains_repo_impl(rctx):
    k = _KICAD[rctx.attr.version]
    rctx.download_and_extract(
        url = k.urls,
        sha256 = k.sha256,
        stripPrefix = k.strip_prefix,
        output = "kicad",
    )
    for p in k.remove:
        rctx.delete("kicad/" + p)
    rctx.download_and_extract(
        url = _FONTS.urls,
        sha256 = _FONTS.sha256,
        stripPrefix = _FONTS.strip_prefix,
        output = "fonts",
    )
    rctx.file("fonts.conf", _FONTS_CONF)
    rctx.file("BUILD.bazel", _BUILD.format(version = rctx.attr.version))

_kicad_toolchains_repo = repository_rule(
    implementation = _kicad_toolchains_repo_impl,
    attrs = {"version": attr.string(mandatory = True)},
)

_LIBS_BUILD = """# Generated by the kicad module extension of hdlf_rules_kicad.
load("@hdlf_rules_kicad//kicad:defs.bzl", "kicad_library")

package(default_visibility = ["//visibility:public"])

# The KiCad {version} symbol and footprint libraries.
kicad_library(
    name = "standard",
    deps = [
        ":footprints",
        ":symbols",
    ],
)

kicad_library(
    name = "symbols",
    symbols = glob(["symbols/*.kicad_sym"], allow_empty = False),
)

kicad_library(
    name = "footprints",
    footprints = glob(["footprints/*.pretty/*.kicad_mod"], allow_empty = False),
)
"""

def _kicad_libs_repo_impl(rctx):
    libs = _LIBS[rctx.attr.version]
    for kind in ("symbols", "footprints"):
        lib = libs[kind]
        rctx.download_and_extract(
            url = lib.urls,
            sha256 = lib.sha256,
            stripPrefix = lib.strip_prefix,
            output = kind,
        )
    rctx.file("BUILD.bazel", _LIBS_BUILD.format(version = rctx.attr.version))

_kicad_libs_repo = repository_rule(
    implementation = _kicad_libs_repo_impl,
    attrs = {"version": attr.string(mandatory = True)},
)

def _freerouting_repo_impl(rctx):
    rctx.download(
        url = _FREEROUTING.urls,
        sha256 = _FREEROUTING.sha256,
        output = "freerouting.jar",
    )
    rctx.file("BUILD.bazel", """# Generated by the kicad module extension of hdlf_rules_kicad.
# Freerouting {version}, for kicad_autoroute.
exports_files(["freerouting.jar"], visibility = ["//visibility:public"])
""".format(version = FREEROUTING_VERSION))

_freerouting_repo = repository_rule(implementation = _freerouting_repo_impl)

def _kicad_impl(mctx):
    version = DEFAULT_KICAD_VERSION
    for mod in mctx.modules:
        if mod.is_root and mod.tags.toolchain:
            if len(mod.tags.toolchain) > 1:
                fail("kicad.toolchain: the root module has %d tags; give one" % len(mod.tags.toolchain))
            version = mod.tags.toolchain[0].version
    if version not in _KICAD:
        fail("hdlf_rules_kicad has no prebuilt KiCad %s; it has %s" % (version, sorted(_KICAD.keys())))
    if version not in _LIBS:
        fail("hdlf_rules_kicad has no pinned libraries for KiCad %s" % version)
    _kicad_toolchains_repo(name = "kicad_toolchains", version = version)
    _kicad_libs_repo(name = "kicad_libs", version = version)
    _freerouting_repo(name = "freerouting")
    return mctx.extension_metadata(reproducible = True)

kicad = module_extension(
    implementation = _kicad_impl,
    doc = """The prebuilt KiCad toolchain.

hdlf_rules_kicad registers it, so a user needs nothing to get KiCad
""" + DEFAULT_KICAD_VERSION + """. The extension also makes `@kicad_libs`, KiCad's symbol and
footprint libraries of the same version: `@kicad_libs//:standard`,
`:symbols` and `:footprints`, each a `kicad_library`. Bring it in with
`use_repo(kicad, "kicad_libs")`.

KiCad's 3D model libraries come from a second extension, `models` in
`@hdlf_rules_kicad//kicad:models.bzl`.

The root module can pick another
version that hdlf_rules_kicad has a prebuilt for:

```starlark
kicad = use_extension("@hdlf_rules_kicad//kicad:extensions.bzl", "kicad")
kicad.toolchain(version = "9.0.9")
```
""",
    tag_classes = {
        "toolchain": tag_class(
            doc = "Picks the KiCad version. Only the root module's tag counts.",
            attrs = {"version": attr.string(
                doc = "A KiCad version that hdlf_rules_kicad has a prebuilt for.",
                default = DEFAULT_KICAD_VERSION,
            )},
        ),
    },
)
