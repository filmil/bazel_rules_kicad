"""The `kicad` module extension: the prebuilt KiCad toolchain (spec H2, H4)."""

# The prebuilt KiCad trees, by the version kicad-cli reports. Each is the
# official lite AppImage of that version (9.0.9.1 is the AppImage's own
# revision 1 of KiCad 9.0.9), unpacked without running it and packed as a
# reproducible tarball by make-kicad-prebuilt.sh. The release notes of each asset name
# the AppImage it came from and its sha256. Only this repository's release
# hosts the tarball, so it has one URL.
_KICAD = {
    "9.0.9": struct(
        urls = ["https://github.com/filmil/bazel_rules_kicad/releases/download/prebuilt-kicad-9.0.9.1/kicad-9.0.9.1-linux-x86_64.tar.xz"],
        sha256 = "7f570bd2161a2dbdd0dca9ef7ba0ab751d422b379c6209385491ecc047f93bff",
        strip_prefix = "kicad-9.0.9.1-linux-x86_64",
        # Links that point outside the tree; a glob would fail on them.
        remove = [
            "shared/lib/python3.11/sitecustomize.py",
            "shared/lib/python3.11/config-3.11-x86_64-linux-gnu/libpython3.11.so",
        ],
    ),
}

DEFAULT_KICAD_VERSION = "9.0.9"

# The AppImage ships no fonts, and its fonts.conf names host directories.
# KiCad's own stroke font is built in; outline (TTF) text needs these.
_FONTS = struct(
    urls = ["https://github.com/dejavu-fonts/dejavu-fonts/releases/download/version_2_37/dejavu-fonts-ttf-2.37.tar.bz2"],
    sha256 = "fa9ca4d13871dd122f61258a80d01751d603b4d3ee14095d65453b4e846e17d7",
    strip_prefix = "dejavu-fonts-ttf-2.37",
)

# fontconfig reads only this: the fonts above, found relative to this file,
# and a cache under XDG_CACHE_HOME, which run_tool points inside the action.
_FONTS_CONF = """<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <dir prefix="relative">fonts/ttf</dir>
  <cachedir prefix="xdg">fontconfig</cachedir>
</fontconfig>
"""

_BUILD = """# Generated by the kicad module extension of rules_kicad.
load("@rules_kicad//kicad/private:kicad_toolchain.bzl", "kicad_toolchain")

kicad_toolchain(
    name = "kicad_impl",
    data = glob(["kicad/**"]),
    fonts = glob(["fonts/ttf/*.ttf"]),
    fonts_conf = "fonts.conf",
    kicad_cli = "kicad/bin/kicad-cli",
    version = "{version}",
)

toolchain(
    name = "kicad",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = ["@rules_kicad//kicad/toolchains:stub_off"],
    toolchain = ":kicad_impl",
    toolchain_type = "@rules_kicad//kicad:toolchain_type",
)
"""

def _kicad_toolchains_repo_impl(rctx):
    k = _KICAD[rctx.attr.version]
    rctx.download_and_extract(
        url = k.urls,
        sha256 = k.sha256,
        stripPrefix = k.strip_prefix,
        output = "kicad",
    )
    for p in k.remove:
        rctx.delete("kicad/" + p)
    rctx.download_and_extract(
        url = _FONTS.urls,
        sha256 = _FONTS.sha256,
        stripPrefix = _FONTS.strip_prefix,
        output = "fonts",
    )
    rctx.file("fonts.conf", _FONTS_CONF)
    rctx.file("BUILD.bazel", _BUILD.format(version = rctx.attr.version))

_kicad_toolchains_repo = repository_rule(
    implementation = _kicad_toolchains_repo_impl,
    attrs = {"version": attr.string(mandatory = True)},
)

def _kicad_impl(mctx):
    version = DEFAULT_KICAD_VERSION
    for mod in mctx.modules:
        if mod.is_root and mod.tags.toolchain:
            version = mod.tags.toolchain[0].version
    if version not in _KICAD:
        fail("rules_kicad has no prebuilt KiCad %s; it has %s" % (version, sorted(_KICAD.keys())))
    _kicad_toolchains_repo(name = "kicad_toolchains", version = version)
    return mctx.extension_metadata(reproducible = True)

kicad = module_extension(
    implementation = _kicad_impl,
    doc = """The prebuilt KiCad toolchain.

rules_kicad registers it, so a user needs nothing to get KiCad
""" + DEFAULT_KICAD_VERSION + """. The root module can pick another
version that rules_kicad has a prebuilt for:

```starlark
kicad = use_extension("@rules_kicad//kicad:extensions.bzl", "kicad")
kicad.toolchain(version = "9.0.9")
```
""",
    tag_classes = {
        "toolchain": tag_class(
            doc = "Picks the KiCad version. Only the root module's tag counts.",
            attrs = {"version": attr.string(
                doc = "A KiCad version that rules_kicad has a prebuilt for.",
                default = DEFAULT_KICAD_VERSION,
            )},
        ),
    },
)
