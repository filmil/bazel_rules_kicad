load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "svgpng_lib",
    srcs = ["main.go"],
    importpath = "github.com/filmil/bazel_rules_kicad/kicad/private/svgpng",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_srwiley_oksvg//:oksvg",
        "@com_github_srwiley_rasterx//:rasterx",
    ],
)

# Pure Go, so a user of the module needs no C++ toolchain to build it.
go_binary(
    name = "svgpng",
    embed = [":svgpng_lib"],
    pure = "on",
    visibility = ["//kicad/toolchains:__pkg__"],
)

go_test(
    name = "svgpng_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":svgpng_lib"],
    pure = "on",
)
