load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//kicad/private:design.bzl", "sheet_check_test")

go_library(
    name = "sheetcheck_lib",
    srcs = ["main.go"],
    importpath = "github.com/filmil/bazel_rules_kicad/kicad/private/sheetcheck",
    visibility = ["//visibility:private"],
    deps = ["//kicad/private/sexpr"],
)

# Pure Go, so a user of the module needs no C++ toolchain to build it.
go_binary(
    name = "sheetcheck",
    embed = [":sheetcheck_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "sheetcheck_test",
    size = "small",
    srcs = ["main_test.go"],
    data = glob(["testdata/**"]),
    embed = [":sheetcheck_lib"],
    pure = "on",
)

# The check's own known-bad inputs (spec T3). Each test passes only if the
# check names the sheet. //tests/design:sch_missing shows the first
# through a rule, in CI.
#
# root.kicad_sch references power.kicad_sch, which is left out.
sheet_check_test(
    name = "detects_missing_sheet_test",
    size = "small",
    srcs = [
        "testdata/leaf.kicad_sch",
        "testdata/sub/io.kicad_sch",
    ],
    expect = "missing:power.kicad_sch",
    root = "testdata/root.kicad_sch",
)

# extra.kicad_sch is in srcs, but no sheet references it.
sheet_check_test(
    name = "detects_unused_sheet_test",
    size = "small",
    srcs = [
        "testdata/extra.kicad_sch",
        "testdata/leaf.kicad_sch",
        "testdata/power.kicad_sch",
        "testdata/sub/io.kicad_sch",
    ],
    expect = "unused:extra.kicad_sch",
    root = "testdata/root.kicad_sch",
)

# circular/a.kicad_sch places the root again.
sheet_check_test(
    name = "detects_circular_sheet_test",
    size = "small",
    srcs = ["testdata/circular/a.kicad_sch"],
    expect = "circular:root.kicad_sch",
    root = "testdata/circular/root.kicad_sch",
)
