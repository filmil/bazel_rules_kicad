# Generated reference documentation for every public .bzl file. It uses the
# module's dev dependencies (stardoc, bazel_lib), so it lives apart from the
# packages a user of the module loads.
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")

stardoc(
    name = "defs_doc",
    out = "gen.defs.md",
    input = "//kicad:defs.bzl",
    deps = [
        "//kicad:defs",
        # rules_java's java_common (kicad_autoroute's toolchain) loads
        # bazel_features, whose library rules_java does not list.
        "@bazel_features//:features",
    ],
)

stardoc(
    name = "extensions_doc",
    out = "gen.extensions.md",
    input = "//kicad:extensions.bzl",
    deps = ["//kicad:extensions"],
)

# `bazel run //docs:update_docs` rewrites the .md files; `bazel test //...`
# fails while one differs from what stardoc writes.
write_source_files(
    name = "update_docs",
    files = {
        "defs.md": ":defs_doc",
        "extensions.md": ":extensions_doc",
    },
)
