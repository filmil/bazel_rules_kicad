#
# kicad_schematic and kicad_pcb: what they stage and provide (issue #13),
# and kicad_erc_test on the small schematic here (issue #14). The sheets
# here hold no parts; the e2e design in integration/e2e is the full one.
load("//kicad:defs.bzl", "determinism_test", "kicad_bom", "kicad_drc_report", "kicad_erc_test", "kicad_library", "kicad_pcb", "kicad_schematic", "swap_test")
load(":design_test.bzl", "bom_action_test", "drc_action_test", "fails_test", "netlist_pcb_info_test", "pcb_info_test", "schematic_info_test")

kicad_schematic(
    name = "sch",
    srcs = ["sheets/power.kicad_sch"],
    root = "main.kicad_sch",
    deps = ["//tests/libs:mine"],
)

schematic_info_test(
    name = "schematic_info_test",
    size = "small",
    target_under_test = ":sch",
)

kicad_library(
    name = "board_lib",
    symbols = ["lib/Fixture2.kicad_sym"],
)

# The board file has another name; it is staged as main.kicad_pcb.
kicad_pcb(
    name = "pcb",
    board = "board.kicad_pcb",
    design_rules = "rules.kicad_dru",
    schematic = ":sch",
    deps = [":board_lib"],
)

pcb_info_test(
    name = "pcb_info_test",
    size = "small",
    target_under_test = ":pcb",
)

kicad_pcb(
    name = "pcb_from_netlist",
    board = "board.kicad_pcb",
    netlist = "circuit.net",
)

netlist_pcb_info_test(
    name = "netlist_pcb_info_test",
    size = "small",
    target_under_test = ":pcb_from_netlist",
)

# A board needs exactly one of schematic and netlist.
kicad_pcb(
    name = "pcb_both",
    board = "board.kicad_pcb",
    netlist = "circuit.net",
    schematic = ":sch",
    tags = ["manual"],
)

fails_test(
    name = "pcb_both_test",
    size = "small",
    message = "give exactly one of schematic and netlist",
    target_under_test = ":pcb_both",
)

kicad_pcb(
    name = "pcb_neither",
    board = "board.kicad_pcb",
    tags = ["manual"],
)

fails_test(
    name = "pcb_neither_test",
    size = "small",
    message = "give exactly one of schematic and netlist",
    target_under_test = ":pcb_neither",
)

# A sheet outside the root's directory cannot keep its relative path.
kicad_schematic(
    name = "sch_outside",
    srcs = ["main.kicad_sch"],
    root = "sheets/power.kicad_sch",
    tags = ["manual"],
)

fails_test(
    name = "sch_outside_test",
    size = "small",
    message = "is not in or below tests/design/sheets",
    target_under_test = ":sch_outside",
)

# Known bad (spec T3): the root references sheets/power.kicad_sch, which
# srcs leaves out. Building it fails and names the sheet; CI checks that
# (.github/workflows/test.yml). Manual, so that //... builds.
kicad_schematic(
    name = "sch_missing",
    root = "bad/main.kicad_sch",
    tags = ["manual"],
)

# The root module's own ERC run, on the small two-sheet schematic: the
# report action through the KiCad and normalize toolchains, the test, and
# the swap and determinism tests over the report.
kicad_erc_test(
    name = "erc_test",
    size = "small",
    schematic = ":sch",
)

swap_test(
    name = "erc_swap_test",
    size = "small",
    targets = [":erc_test_report"],
)

determinism_test(
    name = "erc_determinism_test",
    size = "small",
    target = ":erc_test_report",
)

# DRC on the boards here, for the swap and determinism tests over the
# report: one with schematic parity, one from a netlist (no parity). The
# board here does not match the parts-free schematic, so its report has
# violations; the e2e design in integration/e2e is the one that passes.
kicad_drc_report(
    name = "drc_report",
    pcb = ":pcb",
)

kicad_drc_report(
    name = "drc_netlist_report",
    pcb = ":pcb_from_netlist",
)

swap_test(
    name = "drc_swap_test",
    size = "small",
    targets = [
        ":drc_netlist_report",
        ":drc_report",
    ],
)

determinism_test(
    name = "drc_determinism_test",
    size = "small",
    target = ":drc_report",
)

# The DRC action: --schematic-parity only for a board with a schematic,
# and the design rules, staged as main.kicad_dru, among its inputs.
drc_action_test(
    name = "drc_action_test",
    size = "small",
    parity = True,
    rules = True,
    target_under_test = ":drc_report",
)

drc_action_test(
    name = "drc_netlist_action_test",
    size = "small",
    parity = False,
    rules = False,
    target_under_test = ":drc_netlist_report",
)

# The bill of materials (issue #20): every kicad-cli option given, through
# the KiCad toolchain, the same bytes in two configurations.
kicad_bom(
    name = "bom",
    schematic = ":sch",
)

bom_action_test(
    name = "bom_action_test",
    size = "small",
    target_under_test = ":bom",
)

swap_test(
    name = "bom_swap_test",
    size = "small",
    targets = [":bom"],
)

determinism_test(
    name = "bom_determinism_test",
    size = "small",
    target = ":bom",
)

kicad_bom(
    name = "bom_mismatch",
    labels = ["Refs"],
    schematic = ":sch",
    tags = ["manual"],
)

fails_test(
    name = "bom_mismatch_test",
    size = "small",
    message = "5 fields but 1 labels",
    target_under_test = ":bom_mismatch",
)

kicad_bom(
    name = "bom_comma",
    fields = [
        "Reference",
        "Value,Footprint",
    ],
    labels = [
        "Refs",
        "Both",
    ],
    schematic = ":sch",
    tags = ["manual"],
)

fails_test(
    name = "bom_comma_test",
    size = "small",
    message = "has a comma",
    target_under_test = ":bom_comma",
)
