#
# kicad_step on the board of //tests/design (issue #25): through the KiCad
# and normalize toolchains, the same bytes in two configurations, and the
# model itself.
load("@rules_go//go:def.bzl", "go_test")
load("//kicad:defs.bzl", "determinism_test", "kicad_step", "swap_test")
load(":action_test.bzl", "step_action_test")

kicad_step(
    name = "step",
    pcb = "//tests/design:pcb",
)

step_action_test(
    name = "step_action_test",
    size = "small",
    output = "step.step",
    target_under_test = ":step",
)

swap_test(
    name = "step_swap_test",
    size = "small",
    targets = [":step"],
)

determinism_test(
    name = "step_determinism_test",
    size = "small",
    target = ":step",
)

# The model: the header time at the epoch, a solid, the board body only.
go_test(
    name = "step_files_test",
    size = "small",
    srcs = ["files_test.go"],
    args = ["--step=$(rlocationpath :step)"],
    data = [":step"],
    pure = "on",
    deps = ["@rules_go//go/runfiles"],
)
