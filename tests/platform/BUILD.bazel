#
# Spec P1: other platforms fail at analysis time with a clear message.
load(":platform_test.bzl", "unsupported_fails_test")

# The fallback toolchain fails analysis with the message users see on an
# unsupported host.
unsupported_fails_test(
    name = "unsupported_platform_test",
    size = "small",
    target_under_test = "//kicad/toolchains:unsupported_impl",
)

# A host that rules_kicad v1 does not support, for the CI step that builds
# with --host_platform set to it and expects the message above.
platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)
