#
# golden_test and update_goldens (issue #30). The program's own tests,
# among them a stale golden file in a copy of a workspace, are in
# //kicad/private/golden.
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//kicad:defs.bzl", "golden_test", "update_goldens")
load("//tests:fails_test.bzl", "fails_test")
load(":bad.bzl", "generated_golden_test")
load(":env_test.bzl", "update_env_test")

write_file(
    name = "hello",
    out = "hello.txt",
    content = [
        "hello, golden",
        "",
    ],
)

golden_test(
    name = "hello_test",
    size = "small",
    src = ":hello",
    golden = "expected_hello.txt",
)

# A second update_goldens, with this test only, to look at what it hands
# its program. //:update_goldens is the one to run.
update_goldens(
    name = "update_hello",
    tests = [":hello_test"],
)

update_env_test(
    name = "update_env_test",
    size = "small",
    target_under_test = ":update_hello",
)

# The golden file must be a checked-in file.
generated_golden_test(
    name = "generated_golden",
    src = ":hello",
    golden = ":hello",
)

fails_test(
    name = "generated_golden_test",
    size = "small",
    message = "golden must be a checked-in file of this repository",
    target_under_test = ":generated_golden",
)
