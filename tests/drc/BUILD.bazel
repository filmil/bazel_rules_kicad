#
# DRC on the boards of //tests/design (issue #15), for the swap and
# determinism tests over the report and the action's analysis tests.
load("//kicad:defs.bzl", "determinism_test", "kicad_drc_report", "swap_test")
load(":action_test.bzl", "drc_action_test")

# DRC on the boards here, for the swap and determinism tests over the
# report: one with schematic parity, one from a netlist (no parity). The
# board here does not match the parts-free schematic, so its report has
# violations; the e2e design in integration/e2e is the one that passes.
kicad_drc_report(
    name = "drc_report",
    pcb = "//tests/design:pcb",
)

kicad_drc_report(
    name = "drc_netlist_report",
    pcb = "//tests/design:pcb_from_netlist",
)

swap_test(
    name = "drc_swap_test",
    size = "small",
    targets = [
        ":drc_netlist_report",
        ":drc_report",
    ],
)

determinism_test(
    name = "drc_determinism_test",
    size = "small",
    target = ":drc_report",
)

# The DRC action: --schematic-parity only for a board with a schematic,
# and the design rules, staged as main.kicad_dru, among its inputs.
drc_action_test(
    name = "drc_action_test",
    size = "small",
    parity = True,
    rules = True,
    target_under_test = ":drc_report",
)

drc_action_test(
    name = "drc_netlist_action_test",
    size = "small",
    parity = False,
    rules = False,
    target_under_test = ":drc_netlist_report",
)
