# SPDX-License-Identifier: Apache-2.0
#
# kicad_bom on parts that group (issue #20): R1, R2 and R3 are 10k 0603
# resistors, R4 is one too but marked do-not-populate, and C1 is a 100n
# 0603 capacitor. The expected files are written by hand.
#
# Also kicad_bom on the parts-free schematic of //tests/design: the
# action's options, its analysis failures, and swap and determinism tests.
load("//kicad:defs.bzl", "determinism_test", "golden_test", "kicad_bom", "kicad_schematic", "swap_test")
load("//tests:fails_test.bzl", "fails_test")
load(":action_test.bzl", "bom_action_test")

kicad_schematic(
    name = "sch",
    project = "bom.kicad_pro",
    root = "bom.kicad_sch",
    deps = ["@kicad_libs//:symbols"],
)

# The defaults: R1-R3 share a row; R4 has its own, marked DNP.
kicad_bom(
    name = "default",
    schematic = ":sch",
)

golden_test(
    name = "default_test",
    size = "small",
    src = ":default",
    golden = "expected_default.csv",
)

determinism_test(
    name = "default_determinism_test",
    size = "small",
    target = ":default",
)

# No grouping: a row per part.
kicad_bom(
    name = "ungrouped",
    group_by = [],
    schematic = ":sch",
)

golden_test(
    name = "ungrouped_test",
    size = "small",
    src = ":ungrouped",
    golden = "expected_ungrouped.csv",
)

# Without the do-not-populate part.
kicad_bom(
    name = "no_dnp",
    exclude_dnp = True,
    schematic = ":sch",
)

golden_test(
    name = "no_dnp_test",
    size = "small",
    src = ":no_dnp",
    golden = "expected_no_dnp.csv",
)

# Other columns, sorted by value; the name already ends in .csv.
kicad_bom(
    name = "custom.csv",
    fields = [
        "Value",
        "Reference",
        "${QUANTITY}",
        "${DNP}",
    ],
    group_by = [
        "Value",
        "${DNP}",
    ],
    labels = [
        "Value",
        "Designators",
        "Count",
        "DNP",
    ],
    schematic = ":sch",
    sort_field = "Value",
)

golden_test(
    name = "custom_test",
    size = "small",
    src = ":custom.csv",
    golden = "expected_custom.csv",
)

# The bill of materials (issue #20): every kicad-cli option given, through
# the KiCad toolchain, the same bytes in two configurations.
kicad_bom(
    name = "bom",
    schematic = "//tests/design:sch",
)

bom_action_test(
    name = "bom_action_test",
    size = "small",
    target_under_test = ":bom",
)

swap_test(
    name = "bom_swap_test",
    size = "small",
    targets = [":bom"],
)

determinism_test(
    name = "bom_determinism_test",
    size = "small",
    target = ":bom",
)

kicad_bom(
    name = "bom_mismatch",
    labels = ["Refs"],
    schematic = "//tests/design:sch",
    tags = ["manual"],
)

fails_test(
    name = "bom_mismatch_test",
    size = "small",
    message = "5 fields but 1 labels",
    target_under_test = ":bom_mismatch",
)

kicad_bom(
    name = "bom_comma",
    fields = [
        "Reference",
        "Value,Footprint",
    ],
    labels = [
        "Refs",
        "Both",
    ],
    schematic = "//tests/design:sch",
    tags = ["manual"],
)

fails_test(
    name = "bom_comma_test",
    size = "small",
    message = "has a comma",
    target_under_test = ":bom_comma",
)

kicad_bom(
    name = "bom_no_fields",
    fields = [],
    labels = [],
    schematic = "//tests/design:sch",
    tags = ["manual"],
)

fails_test(
    name = "bom_no_fields_test",
    size = "small",
    message = "fields is empty",
    target_under_test = ":bom_no_fields",
)

kicad_bom(
    name = "bom_empty_name",
    schematic = "//tests/design:sch",
    sort_field = "",
    tags = ["manual"],
)

fails_test(
    name = "bom_empty_name_test",
    size = "small",
    message = "an empty name",
    target_under_test = ":bom_empty_name",
)

kicad_bom(
    name = "bom_group_not_column",
    fields = [
        "Reference",
        "Value",
    ],
    labels = [
        "Refs",
        "Value",
    ],
    schematic = "//tests/design:sch",
    tags = ["manual"],
)

fails_test(
    name = "bom_group_not_column_test",
    size = "small",
    message = "is not in fields; kicad-cli groups only by columns",
    target_under_test = ":bom_group_not_column",
)
