#
# The example consumer. It uses only the public API of rules_kicad, as a
# user of the published module would. The e2e design arrives with the
# kicad_schematic and kicad_pcb rules (milestone M1).
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_kicad//kicad:defs.bzl", "RULES_KICAD_API_VERSION")

# The public package loads and builds.
build_test(
    name = "public_api_builds",
    size = "small",
    targets = ["@rules_kicad//kicad:defs"],
)

# The module resolved here is the one this consumer was written for.
write_file(
    name = "api_version",
    out = "api_version.txt",
    content = [
        RULES_KICAD_API_VERSION,
        "",
    ],
)

diff_test(
    name = "api_version_test",
    size = "small",
    file1 = ":api_version",
    file2 = "expected_api_version.txt",
)
