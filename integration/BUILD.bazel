# The example consumer. It uses only the public API of hdlf_rules_kicad, as a
# user of the published module would. The e2e design arrives with the
# kicad_schematic and kicad_pcb rules (milestone M1).
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@hdlf_rules_kicad//kicad:defs.bzl", "RULES_KICAD_API_VERSION", "golden_test", "kicad_lib_tables", "lib_table_test", "update_goldens")

# The public packages load and build: the rules, and the root package
# with the --@hdlf_rules_kicad//:tools flag that every user's build reads.
build_test(
    name = "public_api_builds",
    size = "small",
    targets = [
        "@hdlf_rules_kicad//:tools",
        "@hdlf_rules_kicad//:tools_prebuilt",
        "@hdlf_rules_kicad//:tools_source",
        "@hdlf_rules_kicad//kicad:defs",
        "@hdlf_rules_kicad//kicad:extensions",
    ],
)

# The module resolved here is the one this consumer was written for.
write_file(
    name = "api_version",
    out = "api_version.txt",
    content = [
        RULES_KICAD_API_VERSION,
        "",
    ],
)

golden_test(
    name = "api_version_test",
    size = "small",
    src = ":api_version",
    golden = "expected_api_version.txt",
)

# The pinned KiCad libraries give tables with no host path.
kicad_lib_tables(
    name = "tables",
    library = "@kicad_libs//:standard",
)

lib_table_test(
    name = "tables_test",
    size = "small",
    tables = [":tables"],
)

# bazel run //:update_goldens, in integration/, writes the built files of
# these tests over their golden files (spec rule 4).
update_goldens(
    name = "update_goldens",
    tests = [
        "//:api_version_test",
        "//e2e/bom:bom_test",
        "//e2e/pos:pos_test",
    ],
)
