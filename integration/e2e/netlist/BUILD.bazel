# The e2e schematic's netlist, the same bytes in two configurations
# (issue #19).
load("@rules_kicad//kicad:defs.bzl", "determinism_test", "kicad_netlist")

kicad_netlist(
    name = "netlist",
    schematic = "//e2e:sch",
    visibility = ["//e2e/timestamp_scan:__pkg__"],
)

determinism_test(
    name = "netlist_determinism_test",
    size = "small",
    target = ":netlist",
)
