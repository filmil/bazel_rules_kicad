# The e2e board's drill files, the same bytes in two configurations
# (issue #23).
load("@rules_kicad//kicad:defs.bzl", "determinism_test", "kicad_drill")

kicad_drill(
    name = "drill",
    pcb = "//e2e:pcb",
    visibility = ["//e2e/timestamp_scan:__pkg__"],
)

determinism_test(
    name = "drill_determinism_test",
    size = "small",
    target = ":drill",
)

# Plated and unplated holes apart, each with a PDF map: the maps' dates
# are scanned too.
kicad_drill(
    name = "drill_map",
    map_format = "pdf",
    pcb = "//e2e:pcb",
    separate_th = True,
    visibility = ["//e2e/timestamp_scan:__pkg__"],
)

determinism_test(
    name = "drill_map_determinism_test",
    size = "small",
    target = ":drill_map",
)
