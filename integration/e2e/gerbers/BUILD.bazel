# The e2e board's Gerber files, the same bytes in two configurations
# (issue #22).
load("@rules_kicad//kicad:defs.bzl", "determinism_test", "kicad_gerbers")

kicad_gerbers(
    name = "gerbers",
    pcb = "//e2e:pcb",
)

determinism_test(
    name = "gerbers_determinism_test",
    size = "small",
    target = ":gerbers",
)
