#
# The e2e board's footprint positions (issue #24), the same bytes in two
# configurations. The expected file is written by hand: it is what
# rules_fab will read.
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_kicad//kicad:defs.bzl", "determinism_test", "kicad_pos")

kicad_pos(
    name = "pos",
    pcb = "//e2e:pcb",
    visibility = ["//e2e/timestamp_scan:__pkg__"],
)

diff_test(
    name = "pos_test",
    size = "small",
    file1 = ":pos",
    file2 = "expected_pos.csv",
)

determinism_test(
    name = "pos_determinism_test",
    size = "small",
    target = ":pos",
)
