#
# The e2e board's footprint positions (issue #24), the same bytes in two
# configurations. The expected file is written by hand: it is what
# rules_fab will read.
load("@hdlf_rules_kicad//kicad:defs.bzl", "determinism_test", "golden_test", "kicad_pos")

kicad_pos(
    name = "pos",
    pcb = "//e2e:pcb",
    visibility = ["//e2e/timestamp_scan:__pkg__"],
)

golden_test(
    name = "pos_test",
    size = "small",
    src = ":pos",
    golden = "expected_pos.csv",
)

determinism_test(
    name = "pos_determinism_test",
    size = "small",
    target = ":pos",
)
