#
# Every export of the e2e design holds no date or time but the epoch
# (issue #27, spec D2). Each export grants this package visibility; a new
# export adds that, and one line here.
load("@rules_kicad//kicad:defs.bzl", "timestamp_scan_test")

timestamp_scan_test(
    name = "timestamp_scan_test",
    size = "small",
    srcs = [
        "//e2e/bom",
        "//e2e/drc:drc_test_report",
        "//e2e/drill",
        "//e2e/drill:drill_map",
        "//e2e/erc:erc_test_report",
        "//e2e/gerbers",
        "//e2e/netlist",
        "//e2e/pos",
        "//e2e/render",
        "//e2e/sch_pdf",
        "//e2e/sch_render",
        "//e2e/step",
    ],
    # The title blocks of the sheets have the designer's date, which KiCad
    # copies into the netlist.
    sources = ["//e2e:sch"],
)
