# SPDX-License-Identifier: Apache-2.0
#
# KiCadRoutingTools v0.24.2 (https://github.com/drandyhaas/KiCadRoutingTools),
# MIT (LICENSE, copied from the release's zip), for the router trial of
# issue https://github.com/filmil/bazel_rules_kicad/issues/104. The release's
# KiCad plugin zip, pinned by sha256 in MODULE.bazel, holds the Python
# sources and the prebuilt router module (grid_router-linux-x86_64.so, the
# release's own binary, byte for byte). Targets use this package, never
# @kicad_routing_tools directly.
package(default_visibility = ["//visibility:public"])

licenses(["notice"])

exports_files(["LICENSE"])

alias(
    name = "files",
    actual = "@kicad_routing_tools//:files",
)

alias(
    name = "route_py",
    actual = "@kicad_routing_tools//:py_router/route.py",
)
