package(default_visibility = ["//visibility:public"])

licenses(["notice"])

exports_files(["LICENSE"])

alias(
    name = "jlcpcb_2l_1oz",
    actual = "@kicad_druid//:JLCPCB/JLCPCB-2L-1oz.kicad_dru",
)
